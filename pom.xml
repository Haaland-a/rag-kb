<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.15</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>rag-kb</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>rag-kb</name>
    <description>RAG 知识库：上传 PDF/MD/TXT → 解析 → 切块 → embedding → pgvector → 带引用溯源的 SSE 流式问答</description>

    <properties>
        <java.version>17</java.version>
        <spring-ai.version>1.1.8</spring-ai.version>
        <mybatis-plus.version>3.5.10.1</mybatis-plus.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
              用 BOM 统一管住所有 spring-ai-* 版本，避免各 starter 传递依赖版本漂移。
              注意：Spring AI 1.1.8 内部没有 spring-boot 版本属性，Boot↔Spring AI 的配对
              靠 <parent> 的 spring-boot-starter-parent:3.5.15 锁定（= Spring AI 1.1.8
              starter pom 显式声明的编译基线）。
            -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web：RestController + SSE（SseEmitter / Flux<ServerSentEvent>） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          Spring AI pgvector 向量库。
          传递依赖：HikariCP 6.3.3 / spring-jdbc 6.2.19 / postgresql 42.7.11 /
          com.pgvector:pgvector 0.1.6 —— 都由 Spring Boot 的 dependencyManagement 管住。
          不需要再单独引 spring-boot-starter-jdbc。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
        </dependency>

        <!--
          OpenAI 兼容客户端（任何兼容 OpenAI 协议的服务都能接：阿里云百炼 / DeepSeek / 硅基流动 …）。
          只用 OpenAiApi / OpenAiEmbeddingModel / OpenAiChatModel / OpenAiChatOptions 这几个类，
          配 baseUrl + apiKey 指向对应端点即可。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!--
          PDF 解析（PagePdfDocumentReader / ParagraphPdfDocumentReader）。
          PDFBox 3.0.8 走传递依赖，不显式声明版本，防止和 Spring AI 编译基线冲突。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-pdf-document-reader</artifactId>
        </dependency>

        <!--
          BCrypt 口令散列。只引 spring-security-crypto 这一个 jar（~1MB），
          **不引** spring-boot-starter-security —— 后者是给多角色 + 方法级权限 +
          各种 AuthenticationProvider 准备的，本项目只有「登录才能用」一个需求，
          引全套要多 ~30MB 类加载 + 一条 FilterChain，2C2G 上不划算。
          认证逻辑自己写在 com.example.kb.user 包（AuthService / AuthInterceptor）。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!--
          阿里云 OSS SDK：照片墙 / 项目截图 / 简历 PDF 存 OSS。
          ⚠️ 只在 rag.storage.type=oss 时才会创建 OSSClient（见 StorageConfig），
          用本地存储时这些类不会被加载，不影响 2C2G 内存。
          自己签 V1 签名也能省掉这个依赖，但签名算法踩坑成本远高于 2MB 的 jar。
        -->
        <dependency>
            <groupId>com.aliyun.oss</groupId>
            <artifactId>aliyun-sdk-oss</artifactId>
            <version>3.17.4</version>
        </dependency>

        <!--
          Tika：MD/TXT/HTML 的兜底解析。
          当前 MD/TXT 自己按行读就够，先不引（2C2G 内存预算 + 少一个依赖少一个坑）。
        -->

        <!--
          MyBatis-Plus：mapper 层。
          ⚠️ 复杂 SQL（窗口函数 ROW_NUMBER、LATERAL JOIN、pgvector <=> 相似度、
          ON CONFLICT 幂等写入）一律走 resources/mapper/*.xml，不用 LambdaWrapper 硬拼 ——
          这些写法 Wrapper 表达不了，硬拼会把 SQL 拆成代码，反而更难维护。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- Actuator：2C2G 上只开 health，方便探活 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 参数校验：@Validated 给 upload/chat 参数兜底 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
